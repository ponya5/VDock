# VDock frontend (Vite) configuration
#
# Copy to frontend/.env. setup.bat / setup.sh write the two port values for
# you, and Settings > Server > Ports edits them. Secrets never go here: this
# file is bundled into the browser build.

# Port the Vite dev server listens on.
VITE_PORT=3000
# Port of the Flask backend the dev server proxies to.
VITE_BACKEND_PORT=5000
# Socket.IO URL override (remote backend). Empty = same host, backend port.
# VITE_WS_URL=
