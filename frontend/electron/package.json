{
  "name": "vdock-electron",
  "version": "2.0.1",
  "description": "VDock - Virtual Stream Deck Desktop App",
  "license": "MIT",
  "author": "VDock Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponya5/VDock2.git",
    "directory": "frontend/electron"
  },
  "main": "main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development npx electron .",
    "build": "npx electron-builder",
    "build-win": "npx electron-builder --win",
    "build-all": "npx electron-builder --win --mac --linux",
    "dist": "npm run build && npx electron-builder"
  },
  "build": {
    "appId": "com.vdock.app",
    "productName": "VDock",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../../dist/vdock-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../dist",
        "to": "backend/frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../public/vdock-icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "../public/vdock-icon.ico",
      "uninstallerIcon": "../public/vdock-icon.ico",
      "installerHeaderIcon": "../public/vdock-icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Productivity",
      "shortcutName": "VDock"
    },
    "portable": {
      "artifactName": "VDock-Portable.exe"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../public/vdock-icon.png"
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ],
      "icon": "../public/vdock-icon.png"
    }
  },
  "dependencies": {
    "auto-launch": "^5.0.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  }
}
