          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "ctrl",
                "`"
              ]
            }
          },
          "secondary_label": "Ctrl+`"
        },
        {
          "id": "btn-claude_prompt-2-0",
          "label": "Explain Error",
          "icon": [
            "fas",
            "robot"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 2,
            "col": 0
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#D97757",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "claude_prompt",
            "config": {
              "prompt": "Explain this error and how to fix it:\n\n{clipboard}",
              "output": "both"
            }
          }
        },
        {
          "id": "btn-claude_prompt-2-1",
          "label": "Fix It",
          "icon": [
            "fas",
            "screwdriver-wrench"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 2,
            "col": 1
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#D97757",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "claude_prompt",
            "config": {
              "prompt": "Fix this failing test or error:\n\n{clipboard}",
              "output": "notify"
            }
          }
        },
        {
          "id": "btn-macro-2-2",
          "label": "Copy",
          "icon": [
            "fas",
            "copy"
