          "icon_type": "fontawesome",
          "position": {
            "row": 1,
            "col": 1
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#334155",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "f11"
              ]
            }
          },
          "secondary_label": "F11"
        },
        {
          "id": "btn-hotkey-1-2",
          "label": "Step Out",
          "icon": [
            "fas",
            "arrow-up"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 1,
            "col": 2
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#334155",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "shift",
                "f11"
              ]
            }
          },
          "secondary_label": "Shift+F11"
        },
        {
          "id": "btn-hotkey-1-3",
          "label": "Console",
          "icon": [
            "fas",
            "terminal"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 1,
            "col": 3
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#334155",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "ctrl",
                "shift",
                "y"
              ]
            }
          },
          "secondary_label": "Ctrl+Shift+Y"
        },
        {
          "id": "btn-hotkey-1-4",
          "label": "Terminal",
          "icon": [
            "fas",
            "terminal"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 1,
            "col": 4
          },
          "size": {
            "rows": 1,
            "cols": 1
