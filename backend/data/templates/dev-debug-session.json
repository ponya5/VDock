          "icon_type": "fontawesome",
          "position": {
            "row": 2,
            "col": 2
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#334155",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "macro",
            "config": {
              "steps": [
                {
                  "type": "clipboard_copy"
                }
              ]
            }
          }
        },
        {
          "id": "btn-metric_cpu_usage-2-3",
