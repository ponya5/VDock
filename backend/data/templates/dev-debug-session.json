{
  "id": "dev-debug-session",
  "name": "Debug Session",
  "description": "Breakpoints and step controls for a VS Code or Cursor debugging session.",
  "icon": "fa-bug",
  "color": "#7c3aed",
  "category": "development",
  "version": "1.0",
  "author": "VDock Team",
  "pages": [
    {
      "id": "page-dev-debug-session",
      "name": "Debug Session",
      "grid_config": {
        "rows": 4,
        "cols": 5
      },
      "buttons": [
        {
          "id": "btn-hotkey-0-0",
          "label": "Start",
          "icon": [
            "fas",
            "play"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 0,
            "col": 0
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#16a34a",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "f5"
              ]
            }
          },
          "secondary_label": "F5"
        },
        {
          "id": "btn-hotkey-0-1",
          "label": "Stop",
          "icon": [
            "fas",
            "stop"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 0,
            "col": 1
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#dc2626",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "shift",
                "f5"
              ]
            }
          },
          "secondary_label": "Shift+F5"
        },
        {
          "id": "btn-hotkey-0-2",
          "label": "Restart",
          "icon": [
            "fas",
            "rotate-right"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 0,
            "col": 2
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#d97706",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "ctrl",
                "shift",
                "f5"
              ]
            }
          },
          "secondary_label": "Ctrl+Shift+F5"
        },
