            "row": 0,
            "col": 4
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#7c3aed",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "f5"
              ]
            }
          },
          "secondary_label": "F5"
        },
