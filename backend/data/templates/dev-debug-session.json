            "row": 0,
            "col": 3
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#7c3aed",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "hotkey",
            "config": {
              "keys": [
                "f9"
              ]
            }
          },
          "secondary_label": "F9"
        },
        {
          "id": "btn-hotkey-0-4",
          "label": "Continue",
          "icon": [
            "fas",
            "forward"
