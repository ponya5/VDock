{
  "id": "dev-claude-code",
  "name": "Claude Code",
  "description": "Drive Claude Code without leaving the keyboard: prompts, reviews, commits and sessions.",
  "icon": "fa-robot",
  "color": "#D97757",
  "category": "development",
  "version": "1.0",
  "author": "VDock Team",
  "pages": [
    {
      "id": "page-dev-claude-code",
      "name": "Claude Code",
      "grid_config": {
        "rows": 4,
        "cols": 5
      },
      "buttons": [
        {
          "id": "btn-claude_continue-0-0",
          "label": "Open Claude",
          "icon": [
            "fas",
            "window-maximize"
          ],
          "icon_type": "fontawesome",
          "position": {
            "row": 0,
            "col": 0
          },
          "size": {
            "rows": 1,
            "cols": 1
          },
          "shape": "rounded",
          "style": {
            "backgroundColor": "#D97757",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "claude_continue",
            "config": {
              "resume": true
            }
          },
          "tooltip": "Resume the last Claude Code session"
        },
        {
          "id": "btn-claude_slash-0-1",
          "label": "Review",
          "icon": [
            "fas",
            "magnifying-glass"
