          "shape": "rounded",
          "style": {
            "backgroundColor": "#D97757",
            "textColor": "#ffffff"
          },
          "enabled": true,
          "action": {
            "type": "claude_slash",
            "config": {
              "command": "/code-review",
              "output": "notify"
            }
          },
          "secondary_label": "/code-review"
