# VDock backend configuration
#
# Copy this file to backend/.env (source installs; setup.bat / setup.sh do it
# for you). The installed app reads <DATA_DIR>/.env instead.
# Never commit .env -- it holds your secrets. Values below are the defaults.
# Lines starting with "#" are optional; remove the "#" to change them.

# --- Core -------------------------------------------------------------------

HOST=127.0.0.1
PORT=5000
# Never True together with Allow LAN: the Werkzeug debugger would be reachable
# from your network.
DEBUG=False
# Where profiles, uploads and config.json live. Empty = default location.
DATA_DIR=

# --- Network & security -----------------------------------------------------

# Prefer the Settings switch (Connect a device). Anyone on your Wi-Fi can press
# your keys unless a deck password is set.
ALLOW_LAN=False
# Address shown in the "Connect a device" QR code. Empty = auto-detect.
DECK_HOST=
# Extra allowed browser origins, comma separated. Leave unset for the built-in
# localhost list.
# CORS_ORIGINS=
REQUIRE_AUTH=False
# Set the deck password from Settings > Server rather than here.
AUTH_PASSWORD=
# Seconds a deck login stays valid.
TOKEN_EXPIRATION=86400
# Leave empty: VDock generates a random signing key on first start and saves
# it here. Never reuse a key you found in documentation.
SECRET_KEY=
# Off by default (local use). Only enable if the deck is exposed to untrusted
# clients; polling widgets and Mission Control are exempt either way.
# RATELIMIT_ENABLED=False
# RATELIMIT_DEFAULT=200 per day, 50 per hour
# RATELIMIT_STORAGE_URL=memory://
# Serve HTTPS with the cert/key below (paths relative to backend/). Needed for
# the phone's installable app and Keep-screen-on. See docs/development/DEVELOPER_GUIDE.md.
USE_SSL=False
SSL_CERT_PATH=cert.pem
SSL_KEY_PATH=key.pem
# Command actions run shell commands. Keep off unless you need them.
ALLOW_COMMAND_EXECUTION=False
REQUIRE_COMMAND_CONFIRMATION=True
ENABLE_PLUGINS=True

# --- Integrations (all optional) --------------------------------------------
# Each pack detects what it can use and greys out only the actions it cannot
# run, so VDock works with none of these set.

# GitHub token: only for the live PR / CI / notification widgets (the gh CLI
# actions reuse your `gh auth login`). Scopes: repo, notifications.
# https://github.com/settings/tokens
GITHUB_TOKEN=
# Anthropic API key: only for the "Claude (API)" action (the Claude Code CLI
# actions use your existing `claude` login). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# WeatherAPI key: only for the backend Weather action; the screensaver weather
# uses Open-Meteo and needs no key. https://www.weatherapi.com/
WEATHERAPI_KEY=
# Default repository for GitHub actions when VDock cannot infer one from the
# focused editor window.
VDOCK_DEFAULT_REPO_PATH=

# --- Advanced ---------------------------------------------------------------

# Where "Request a feature" is relayed. Empty = the project maintainer.
VDOCK_FEEDBACK_EMAIL=
